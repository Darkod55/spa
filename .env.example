# Runtime (xCloud sets PORT; HOST should stay 0.0.0.0 in production)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public site origin (canonical / OG / EmDash) — use your live domain
SITE_URL=https://www.example.com
PUBLIC_SITE_URL=https://www.example.com

# EmDash
# Generate a fresh key for production; do not reuse a local/dev key from git history.
EMDASH_ENCRYPTION_KEY=
EMDASH_SITE_URL=https://www.example.com

# Contact form → ZeptoMail (Zoho transactional email)
# Create a Mail Agent + Send Mail Token in ZeptoMail, verify your from-domain.
ZEPTOMAIL_API_KEY=
# Optional override (defaults to https://api.zeptomail.com/v1.1/email)
# EU example: https://api.zeptomail.eu/v1.1/email
# CPaaS example: https://cpaas.zoho.com/v1.1/email
ZEPTOMAIL_API_URL=
ZEPTOMAIL_FROM_ADDRESS=hello@yourdomain.com
ZEPTOMAIL_FROM_NAME=The Square Peg Agency

# Inbox that receives website enquiries
CONTACT_TO_ADDRESS=hello@yourdomain.com
CONTACT_TO_NAME=The Square Peg Agency
