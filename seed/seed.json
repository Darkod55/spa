					"content": [
						{
							"_type": "marketing_hero",
							"_version": 2,
							"_key": "hero",
							"variant": "home",
							"background": "primary",
							"label": "The Square Peg Agency",
							"title": "Why fit in when you can stand out?",
							"highlight": "stand out?",
							"subtitle": "Strategic marketing for organisations in the addiction, mental health, behavioural health and wellness sectors.",
							"primary_cta_label": "Book a discovery call",
							"primary_cta_url": "/contact",
							"secondary_cta_label": "How we help",
							"secondary_cta_url": "/services",
							"image": {
								"$media": {
