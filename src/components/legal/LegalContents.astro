---
import type { MarkdownHeading } from "astro";
import SlashMark from "../ui/SlashMark.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const items = headings.filter((h) => h.depth === 2);

if (items.length < 3) {
	return null;
}
---

<nav class="legal-contents" aria-labelledby="contents-title">
	<div class="legal-contents__heading">
		<SlashMark class="legal-contents__slash" />
		<h2 id="contents-title" class="legal-contents__title">Contents</h2>
	</div>
	<ol class="legal-contents__list">
		{
			items.map((heading, i) => (
				<li>
					<a class="legal-contents__link" href={`#${heading.slug}`}>
						<span class="legal-contents__num">
							{String(i + 1).padStart(2, "0")}
						</span>
						<span class="legal-contents__label">{heading.text}</span>
					</a>
				</li>
			))
		}
	</ol>
</nav>

<style>
	.legal-contents {
		background: var(--color-grey-50);
		padding: 32px 32px 36px;
		margin: 16px 0 8px;
		clip-path: polygon(
			0 0,
			calc(100% - 36px) 0,
			100% 36px,
			100% 100%,
			0 100%
		);
		box-shadow: inset 0 -5px 0 var(--color-red);
	}

	.legal-contents__heading {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 16px;
	}

	.legal-contents__slash {
		width: 44px;
		height: 16px;
	}

	.legal-contents__title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.375rem; /* 22px */
		line-height: 1.2;
		text-transform: uppercase;
		color: var(--color-navy);
	}

	.legal-contents__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0 28px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.legal-contents__link {
		display: flex;
		align-items: baseline;
		gap: 12px;
		min-height: 44px;
		padding: 10px 0;
		border-bottom: 1px solid var(--color-grey-200);
		color: var(--color-navy);
		text-decoration: none;
	}

	.legal-contents__num {
		flex-shrink: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.875rem; /* 14px */
		color: var(--color-red);
	}

	.legal-contents__label {
		font-family: var(--font-body);
		font-size: 0.875rem; /* 14px */
		font-weight: 500;
		line-height: 1.45;
	}

	.legal-contents__link:hover,
	.legal-contents__link:focus-visible {
		color: var(--color-red);
	}

	.legal-contents__link:hover .legal-contents__num,
	.legal-contents__link:focus-visible .legal-contents__num {
		color: var(--color-red);
	}

	@media (max-width: 639px) {
		.legal-contents {
			padding: 24px;
		}

		.legal-contents__list {
			grid-template-columns: 1fr;
		}
	}
</style>
