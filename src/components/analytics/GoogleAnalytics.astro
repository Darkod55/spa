---
/**
 * GA4 gtag — only renders when PUBLIC_GA_MEASUREMENT_ID is set (e.g. G-XXXXXXXX).
 * Loaded after idle/load so it does not compete with LCP on mobile.
 * Cookie consent can wrap this later.
 */
const measurementId = (
	(typeof process !== "undefined" && process.env.PUBLIC_GA_MEASUREMENT_ID) ||
	import.meta.env.PUBLIC_GA_MEASUREMENT_ID ||
	""
).trim();

const enabled = /^G-[A-Z0-9]+$/i.test(measurementId);
---

{
	enabled && (
		<script is:inline define:vars={{ measurementId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			window.gtag = gtag;

			function loadGa() {
				if (window.__spaGaLoaded) return;
				window.__spaGaLoaded = true;
				const script = document.createElement("script");
				script.async = true;
				script.src =
					"https://www.googletagmanager.com/gtag/js?id=" + measurementId;
				script.onload = function () {
					gtag("js", new Date());
					gtag("config", measurementId);
				};
				document.head.appendChild(script);
			}

			if ("requestIdleCallback" in window) {
				requestIdleCallback(loadGa, { timeout: 3500 });
			} else {
				window.addEventListener("load", function () {
					setTimeout(loadGa, 1);
				});
			}
		</script>
	)
}
