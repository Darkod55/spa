---
import Container from "../../ui/Container.astro";
import SlashMark from "../../ui/SlashMark.astro";
import NumberedStrips from "../../ui/NumberedStrips.astro";
import { highlightBraces } from "../../../utils/highlight";
import { notFound } from "../../../data/notFound";

const titleHtml = highlightBraces(notFound.linksTitle);
---

<section class="nf-links clears-footer" data-tone="light">
	<div class="nf-links__shade" aria-hidden="true"></div>
	<Container class="nf-links__inner">
		<div class="nf-links__intro">
			<SlashMark color="var(--color-red)" />
			<h2 class="nf-links__title" set:html={titleHtml} />
			<p class="nf-links__text">{notFound.linksIntro}</p>
		</div>
		<nav class="nf-links__nav" aria-label="Helpful links">
			<NumberedStrips
				items={[...notFound.links]}
				tone="light"
				columns={1}
				step={16}
				size="lg"
			/>
		</nav>
	</Container>
</section>

<style>
	.nf-links {
		position: relative;
		overflow: hidden;
		background: var(--color-grey-50);
	}

	.nf-links__shade {
		position: absolute;
		inset: 0;
		background: var(--color-grey-100);
		/* Keep the diagonal under the copy so the intro text stays on a flat field */
		clip-path: polygon(0 88%, 100% 58%, 100% 100%, 0 100%);
		pointer-events: none;
	}

	.nf-links :global(.nf-links__inner) {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 40px 80px;
		padding-top: 40px;
		padding-bottom: 152px;
	}

	.nf-links__intro {
		display: flex;
		flex: 1 1 340px;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
	}

	.nf-links__title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(2.25rem, 3.6vw, 3.25rem); /* 36px → 52px */
		line-height: 1.02;
		text-transform: uppercase;
		color: var(--color-navy);
	}

	.nf-links__text {
		margin: 0;
		font-family: var(--font-body);
		font-size: 1rem; /* 16px */
		line-height: 1.75;
		color: var(--color-text-body);
		max-width: 36em;
	}

	.nf-links__nav {
		flex: 1.3 1 520px;
		min-width: 0;
	}

	@media (max-width: 639px) {
		.nf-links :global(.nf-links__inner) {
			padding-top: 24px;
			padding-bottom: 128px;
		}
	}
</style>
