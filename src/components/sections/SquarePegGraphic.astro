---
import TiltedMark from "../ui/TiltedMark.astro";

interface Props {
	class?: string;
	/**
	 * Colour scheme:
	 * - `navy` — navy boxes, red logo face (default)
	 * - `red` — red boxes, navy logo face
	 */
	scheme?: "navy" | "red";
	/** Animate the tilt on scroll into view. Default true. */
	animate?: boolean;
}

const { class: className, scheme = "navy", animate = true } = Astro.props;
---

<div
	class:list={[
		"sp-graphic",
		`sp-graphic--${scheme}`,
		animate && "sp-graphic--animate",
		className,
	]}
	aria-hidden="true"
>
	<div class="sp-graphic__grid">
		<span></span>
		<span></span>
		<span></span>
		<span></span>
	</div>
	<div class="sp-graphic__tilt">
		<TiltedMark
			size="100%"
			outline="9px"
			angle="-15deg"
			faceColour="var(--sp-face)"
			class="sp-graphic__mark"
		/>
	</div>
</div>

<style>
	.sp-graphic {
		--sp-box: var(--color-navy);
		--sp-face: var(--color-red);
		position: relative;
		width: clamp(220px, 28vw, 300px);
		aspect-ratio: 1 / 1;
		flex: none;
	}

	.sp-graphic--red {
		--sp-box: var(--color-red);
		--sp-face: var(--color-navy);
	}

	.sp-graphic__grid {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.sp-graphic__grid > span {
		display: block;
		background: var(--sp-box);
	}

	.sp-graphic__tilt {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 50%;
		aspect-ratio: 1 / 1;
		transform: translate(-50%, -50%);
	}

	.sp-graphic__tilt :global(.sp-graphic__mark) {
		width: 100%;
		height: 100%;
	}

	@media (max-width: 639px) {
		.sp-graphic__grid {
			gap: 10px;
		}

		.sp-graphic__tilt :global(.sp-graphic__mark) {
			padding: 6px;
		}
	}

	/* Entrance: start upright + faded; settle to -15deg when .is-inview */
	.sp-graphic--animate .sp-graphic__tilt :global(.sp-graphic__mark) {
		opacity: 0;
		transform: rotate(0deg);
		transition:
			opacity 400ms ease-out,
			transform 400ms ease-out;
	}

	.sp-graphic--animate.is-inview .sp-graphic__tilt :global(.sp-graphic__mark),
	.sp-graphic--animate:not(.sp-graphic--js) .sp-graphic__tilt :global(.sp-graphic__mark) {
		opacity: 1;
		transform: rotate(-15deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.sp-graphic--animate .sp-graphic__tilt :global(.sp-graphic__mark) {
			opacity: 1;
			transform: rotate(-15deg);
			transition: none;
		}
	}
</style>

{
	animate && (
		<script>
			const roots = document.querySelectorAll(".sp-graphic--animate");
			for (const root of roots) {
				root.classList.add("sp-graphic--js");
			}

			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				for (const root of roots) root.classList.add("is-inview");
			} else if ("IntersectionObserver" in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-inview");
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.35 },
				);
				for (const root of roots) io.observe(root);
			} else {
				for (const root of roots) root.classList.add("is-inview");
			}
		</script>
	)
}
