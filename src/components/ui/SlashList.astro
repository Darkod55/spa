---
interface Props {
	/** List items as strings; or leave empty and pass <li> via slot */
	items?: string[];
	/** Bullet + text colour pairing */
	tone?: "light" | "dark";
	columns?: 1 | 2;
	class?: string;
}

const {
	items,
	tone = "light",
	columns = 1,
	class: className = "",
} = Astro.props;

const stroke =
	tone === "dark" ? "var(--color-red-on-navy)" : "var(--color-red)";
---

<ul
	class:list={[
		"slash-list-comp",
		`slash-list-comp--${tone}`,
		`slash-list-comp--cols-${columns}`,
		className,
	]}
>
	{
		items
			? items.map((item) => (
					<li>
						<svg
							class="slash-list-comp__mark"
							width="14"
							height="18"
							viewBox="0 0 14 18"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M2 16L12 2"
								stroke={stroke}
								stroke-width="2.4"
								stroke-linecap="round"
							/>
						</svg>
						<span>{item}</span>
					</li>
				))
			: (
					<slot />
				)
	}
</ul>

<style>
	.slash-list-comp {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.slash-list-comp--cols-2 {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 14px 24px;
	}

	.slash-list-comp :global(li) {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		font-family: var(--font-body);
		font-size: 0.9375rem; /* 15px */
		font-weight: 500;
		line-height: 1.5;
	}

	.slash-list-comp--light :global(li) {
		color: var(--color-navy);
	}

	.slash-list-comp--dark :global(li) {
		color: var(--color-white);
	}

	.slash-list-comp__mark {
		flex: none;
		margin-top: 2px;
	}

	@media (max-width: 639px) {
		.slash-list-comp--cols-2 {
			grid-template-columns: 1fr;
		}
	}
</style>
