---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Label from "./Label.astro";

interface Props {
	name: string;
	role: string;
	bio: string;
	photo?: ImageMetadata;
	class?: string;
}

const { name, role, bio, photo, class: className = "" } = Astro.props;

const isPlaceholderName = name.trim() === "[Name]";
const initial = isPlaceholderName
	? "?"
	: (name.trim().charAt(0).toUpperCase() || "?");
const photoAlt = `${name}, ${role}`;
---

<article class:list={["team-card", className]}>
	<div class="team-card__photo">
		{
			photo ? (
				<Image
					src={photo}
					alt={photoAlt}
					class="team-card__img"
					widths={[360, 540, 720]}
					sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
					quality={85}
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="team-card__placeholder" aria-hidden="true">
					<span class="team-card__initial">{initial}</span>
					<span class="team-card__photo-note">[Team photo]</span>
				</div>
			)
		}
		<span class="team-card__corner" aria-hidden="true"></span>
	</div>

	<div class="team-card__body">
		<h3 class="team-card__name">{name}</h3>
		<div class="team-card__role">
			<Label variant="red" size="small">{role}</Label>
		</div>
		<p class="team-card__bio">{bio}</p>
	</div>
</article>

<style>
	.team-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 100%;
		background: var(--color-white);
		box-shadow: inset 0 -5px 0 var(--color-red);
	}

	.team-card__photo {
		position: relative;
		aspect-ratio: 4 / 4.2;
		overflow: hidden;
		clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
	}

	.team-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
		display: block;
	}

	.team-card__placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		height: 100%;
		background: #c9cfda;
	}

	.team-card__initial {
		font-family: var(--font-heading);
		font-size: 4rem; /* 64px */
		font-weight: 600;
		line-height: 1;
		text-transform: uppercase;
		color: var(--color-navy);
	}

	.team-card__photo-note {
		font-family: var(--font-body);
		font-size: var(--fs-meta); /* 12px */
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #31394a;
	}

	.team-card__corner {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: var(--color-navy);
		clip-path: polygon(78% 0, 100% 0, 100% 22%);
	}

	.team-card__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		flex: 1 1 auto;
		padding: 8px 28px 36px;
	}

	.team-card__name {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.875rem; /* 30px */
		font-weight: 600;
		line-height: 1.1;
		text-transform: uppercase;
		color: var(--color-navy);
	}

	.team-card__role {
		align-self: flex-start;
		max-width: 100%;
	}

	/* Long roles (e.g. Founder and CEO) wrap inside the parallelogram */
	.team-card__role :global(.label) {
		--slant: 9px;
		display: inline-flex;
		max-width: 100%;
		padding: 6px 20px;
		font-size: 0.875rem; /* 14px */
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 1.3;
		white-space: normal;
		text-align: left;
		height: auto;
	}

	.team-card__role :global(.label__text) {
		white-space: normal;
	}

	.team-card__bio {
		margin: 4px 0 0;
		font-family: var(--font-body);
		font-size: var(--fs-small); /* 14px */
		font-weight: 400;
		line-height: 1.75;
		color: var(--color-text-body);
	}

	@media (max-width: 639px) {
		.team-card__body {
			padding: 8px 24px 32px;
		}
	}
</style>
