---
export type NumberedStripItem =
	| string
	| { text: string; href?: string; description?: string };

interface Props {
	items: readonly NumberedStripItem[];
	tone?: "light" | "dark" | "muted";
	columns?: 1 | 2;
	/** Indent added per item in px (default 0). Halved below 640px. */
	step?: number;
	size?: "md" | "lg";
	ordered?: boolean;
	/** Fade/rise in when the list enters the viewport */
	animate?: boolean;
	class?: string;
}

const {
	items,
	tone = "light",
	columns = 1,
	step = 0,
	size = "md",
	ordered = false,
	animate = false,
	class: className = "",
} = Astro.props;

const Tag = ordered ? "ol" : "ul";

function itemText(item: NumberedStripItem): string {
	return typeof item === "string" ? item : item.text;
}

function itemHref(item: NumberedStripItem): string | undefined {
	return typeof item === "string" ? undefined : item.href;
}

function itemDescription(item: NumberedStripItem): string | undefined {
	return typeof item === "string" ? undefined : item.description;
}
---

<Tag
	class:list={[
		"numbered-strips",
		`numbered-strips--${tone}`,
		`numbered-strips--${size}`,
		`numbered-strips--cols-${columns}`,
		animate && "numbered-strips--animate",
		className,
	]}
	style={`--strip-step-base: ${step}px;`}
>
	{
		items.map((item, index) => {
			const text = itemText(item);
			const href = itemHref(item);
			const description = itemDescription(item);
			const rich = Boolean(description);
			const number = String(index + 1).padStart(2, "0");
			const style = `--i: ${index}`;
			const body = (
				<>
					<span class="numbered-strips__num">{number}</span>
					<span class="numbered-strips__body">
						<span class="numbered-strips__label">{text}</span>
						{description && (
							<span class="numbered-strips__desc">{description}</span>
						)}
					</span>
					{href && rich && (
						<svg
							class="numbered-strips__arrow"
							width="20"
							height="12"
							viewBox="0 0 20 12"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
							focusable="false"
						>
							<path d="M0 6 H16" stroke="currentColor" stroke-width="1.8" />
							<path
								d="M12 1 L17 6 L12 11"
								stroke="currentColor"
								stroke-width="1.8"
								fill="none"
								stroke-linejoin="miter"
							/>
						</svg>
					)}
				</>
			);

			return (
				<li class="numbered-strips__item" style={style}>
					{href ? (
						<a
							class:list={[
								"numbered-strips__strip",
								"focus-clip",
								rich && "numbered-strips__strip--rich",
								href && "numbered-strips__strip--link",
							]}
							href={href}
						>
							{body}
						</a>
					) : (
						<span
							class:list={[
								"numbered-strips__strip",
								rich && "numbered-strips__strip--rich",
							]}
						>
							{body}
						</span>
					)}
				</li>
			);
		})
	}
</Tag>

<style>
	.numbered-strips {
		--strip-step-base: 0px;
		--strip-step: var(--strip-step-base);
		display: grid;
		gap: 10px 12px;
		margin: 0;
		padding: 0;
		list-style: none;
		width: 100%;
		min-width: 0;
	}

	.numbered-strips--cols-1 {
		grid-template-columns: minmax(0, 1fr);
	}

	.numbered-strips--cols-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.numbered-strips__item {
		list-style: none;
		margin: 0;
		padding: 0;
		min-width: 0;
		margin-left: calc(var(--i) * var(--strip-step));
		max-width: calc(100% - (var(--i) * var(--strip-step)));
	}

	.numbered-strips__strip {
		--slant: 16px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 16px;
		width: 100%;
		min-height: 64px;
		padding: 0 28px;
		text-decoration: none;
		clip-path: polygon(
			var(--slant) 0,
			100% 0,
			calc(100% - var(--slant)) 100%,
			0 100%
		);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.numbered-strips--lg .numbered-strips__strip {
		--slant: 18px;
		gap: 20px;
		min-height: 72px;
		padding: 12px 36px;
	}

	.numbered-strips--lg .numbered-strips__strip--rich {
		padding: 12px 40px 12px 36px;
	}

	.numbered-strips--light .numbered-strips__strip {
		background: var(--color-white);
		color: var(--color-navy);
	}

	.numbered-strips--muted .numbered-strips__strip {
		background: var(--color-grey-50);
		color: var(--color-navy);
	}

	.numbered-strips--dark .numbered-strips__strip {
		background: var(--color-navy);
		color: var(--color-white);
	}

	.numbered-strips__num {
		flex-shrink: 0;
		font-family: var(--font-heading);
		font-size: 0.9375rem; /* 15px */
		font-weight: 600;
		line-height: 1;
		transition: color 0.2s ease;
	}

	.numbered-strips--light .numbered-strips__num,
	.numbered-strips--muted .numbered-strips__num {
		color: var(--color-red);
	}

	.numbered-strips--dark .numbered-strips__num {
		color: var(--color-red-on-navy);
	}

	.numbered-strips--lg .numbered-strips__num {
		font-size: 1.375rem; /* 22px */
	}

	.numbered-strips__body {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
		flex: 1 1 auto;
	}

	.numbered-strips__label {
		font-family: var(--font-body);
		font-size: 0.9375rem; /* 15px */
		font-weight: 600;
		line-height: 1.3;
		transition: color 0.2s ease;
	}

	.numbered-strips--lg .numbered-strips__label {
		font-size: 1rem; /* 16px */
		line-height: 1.4;
	}

	.numbered-strips__strip--rich .numbered-strips__label {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.25rem; /* 20px */
		line-height: 1.2;
		text-transform: uppercase;
	}

	.numbered-strips__desc {
		font-family: var(--font-body);
		font-size: 0.875rem; /* 14px */
		font-weight: 400;
		line-height: 1.5;
		color: var(--color-text-body);
	}

	.numbered-strips__arrow {
		flex-shrink: 0;
		margin-left: auto;
		color: var(--color-red);
		transition: transform 0.2s ease;
	}

	.numbered-strips--dark .numbered-strips__arrow {
		color: var(--color-red-on-navy);
	}

	/* Plain linked strips (no description) — full-fill hover, as before */
	.numbered-strips--light
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover,
	.numbered-strips--muted
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover {
		background: var(--color-red);
		color: var(--color-white);
	}

	.numbered-strips--light
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover
		.numbered-strips__num,
	.numbered-strips--light
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover
		.numbered-strips__label,
	.numbered-strips--muted
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover
		.numbered-strips__num,
	.numbered-strips--muted
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover
		.numbered-strips__label {
		color: var(--color-white);
	}

	.numbered-strips--light
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover
		.numbered-strips__arrow,
	.numbered-strips--muted
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover
		.numbered-strips__arrow {
		color: var(--color-white);
	}

	.numbered-strips--dark
		a.numbered-strips__strip--link:not(.numbered-strips__strip--rich):hover {
		background: var(--color-royal);
	}

	/* Rich linked strips — title goes red, arrow nudges */
	.numbered-strips--light a.numbered-strips__strip--rich:hover .numbered-strips__label,
	.numbered-strips--light
		a.numbered-strips__strip--rich:focus-visible
		.numbered-strips__label,
	.numbered-strips--muted a.numbered-strips__strip--rich:hover .numbered-strips__label,
	.numbered-strips--muted
		a.numbered-strips__strip--rich:focus-visible
		.numbered-strips__label {
		color: var(--color-red);
	}

	@media (prefers-reduced-motion: no-preference) {
		.numbered-strips--light
			a.numbered-strips__strip--rich:hover
			.numbered-strips__arrow,
		.numbered-strips--light
			a.numbered-strips__strip--rich:focus-visible
			.numbered-strips__arrow,
		.numbered-strips--muted
			a.numbered-strips__strip--rich:hover
			.numbered-strips__arrow,
		.numbered-strips--muted
			a.numbered-strips__strip--rich:focus-visible
			.numbered-strips__arrow {
			transform: translateX(4px);
		}

		.numbered-strips--animate.numbered-strips--js .numbered-strips__item {
			opacity: 0;
			transform: translateY(14px);
			transition:
				opacity 0.7s ease-out,
				transform 0.7s ease-out;
			transition-delay: calc(var(--i) * 0.14s);
		}

		.numbered-strips--animate.numbered-strips--js.is-inview .numbered-strips__item {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 639px) {
		.numbered-strips {
			--strip-step: calc(var(--strip-step-base) / 2);
		}

		.numbered-strips--cols-2 {
			grid-template-columns: minmax(0, 1fr);
		}

		.numbered-strips--md .numbered-strips__strip {
			--slant: 12px;
			gap: 10px;
			min-height: 56px;
			padding: 0 20px;
		}

		.numbered-strips--lg .numbered-strips__strip {
			--slant: 14px;
			gap: 14px;
			padding: 12px 28px;
		}

		.numbered-strips--lg .numbered-strips__strip--rich {
			padding: 12px 28px 12px 24px;
		}

		.numbered-strips--lg .numbered-strips__num {
			font-size: 1.125rem; /* 18px */
		}

		.numbered-strips--lg .numbered-strips__label {
			font-size: 0.9375rem; /* 15px */
		}

		.numbered-strips__strip--rich .numbered-strips__label {
			font-size: 1.125rem; /* 18px */
		}

		.numbered-strips--md .numbered-strips__num,
		.numbered-strips--md .numbered-strips__label {
			font-size: 0.875rem; /* 14px */
		}
	}
</style>

{
	animate && (
		<script>
			const roots = document.querySelectorAll(".numbered-strips--animate");
			for (const root of roots) {
				root.classList.add("numbered-strips--js");
			}

			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				for (const root of roots) root.classList.add("is-inview");
			} else if ("IntersectionObserver" in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-inview");
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.35 },
				);
				for (const root of roots) io.observe(root);
			} else {
				for (const root of roots) root.classList.add("is-inview");
			}
		</script>
	)
}
