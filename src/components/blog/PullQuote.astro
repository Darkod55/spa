---
import SlashMark from "../ui/SlashMark.astro";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<figure class:list={["pull-quote", className]}>
	<SlashMark class="pull-quote__slash" />
	<blockquote class="pull-quote__quote">
		<slot />
	</blockquote>
</figure>

<style>
	.pull-quote {
		margin: 32px 0;
		padding: 40px 44px;
		background: var(--color-grey-50);
		clip-path: polygon(
			0 0,
			calc(100% - 40px) 0,
			100% 40px,
			100% 100%,
			0 100%
		);
		box-shadow: inset 0 -5px 0 var(--color-red);
	}

	.pull-quote__slash {
		width: 56px;
		height: 20px;
		margin-bottom: 16px;
	}

	.pull-quote__quote {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: clamp(1.5rem, 2.2vw, 2rem); /* 24px → 32px */
		line-height: 1.25;
		text-transform: uppercase;
		color: var(--color-navy);
	}

	@media (max-width: 639px) {
		.pull-quote {
			padding: 28px 24px;
		}
	}
</style>
