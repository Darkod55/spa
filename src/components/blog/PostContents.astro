---
import type { MarkdownHeading } from "astro";
import SlashMark from "../ui/SlashMark.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const items = headings.filter((h) => h.depth === 2);

if (items.length < 3) {
	return null;
}
---

<nav class="post-contents" aria-labelledby="toc-title" data-post-toc>
	<div class="post-contents__heading">
		<SlashMark
			class="post-contents__slash"
			color="var(--color-red-on-navy)"
		/>
		<h2 id="toc-title" class="post-contents__title">In this article</h2>
	</div>
	<ol class="post-contents__list">
		{
			items.map((heading, i) => (
				<li>
					<a
						class="post-contents__link"
						href={`#${heading.slug}`}
						data-toc-link
						data-toc-target={heading.slug}
					>
						<span class="post-contents__num">
							{String(i + 1).padStart(2, "0")}
						</span>
						<span class="post-contents__label">{heading.text}</span>
					</a>
				</li>
			))
		}
	</ol>
</nav>

<script>
	function initPostToc() {
		const nav = document.querySelector("[data-post-toc]");
		if (!(nav instanceof HTMLElement)) return;

		const links = [
			...nav.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
		];
		if (!links.length) return;

		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		const sections = links
			.map((link) => {
				const id = link.dataset.tocTarget;
				if (!id) return null;
				const el = document.getElementById(id);
				return el ? { id, el, link } : null;
			})
			.filter((item): item is { id: string; el: HTMLElement; link: HTMLAnchorElement } =>
				Boolean(item),
			);

		if (!sections.length) return;

		const setActive = (id: string) => {
			for (const section of sections) {
				section.link.classList.toggle(
					"post-contents__link--active",
					section.id === id,
				);
			}
		};

		if (reduceMotion || !("IntersectionObserver" in window)) {
			return;
		}

		const visible = new Map<string, number>();

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const id = entry.target.id;
					if (entry.isIntersecting) {
						visible.set(id, entry.intersectionRatio);
					} else {
						visible.delete(id);
					}
				}

				let bestId = "";
				let bestRatio = 0;
				for (const [id, ratio] of visible) {
					if (ratio >= bestRatio) {
						bestRatio = ratio;
						bestId = id;
					}
				}
				if (bestId) setActive(bestId);
			},
			{
				rootMargin: "-20% 0px -55% 0px",
				threshold: [0, 0.25, 0.5, 0.75, 1],
			},
		);

		for (const section of sections) {
			observer.observe(section.el);
		}
	}

	initPostToc();
	document.addEventListener("astro:page-load", initPostToc);
</script>

<style>
	.post-contents {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 36px 32px 40px;
		background: var(--color-navy);
		color: var(--color-white);
		clip-path: polygon(
			0 0,
			calc(100% - 40px) 0,
			100% 40px,
			100% 100%,
			0 100%
		);
		box-shadow: inset 0 -5px 0 var(--color-red);
	}

	.post-contents__heading {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
	}

	.post-contents__slash {
		width: 44px;
		height: 16px;
	}

	.post-contents__title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.625rem; /* 26px */
		line-height: 1.15;
		text-transform: uppercase;
		color: var(--color-white);
	}

	.post-contents__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.post-contents__link {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		min-height: 44px;
		padding: 10px 0;
		border-bottom: 1px solid rgb(255 255 255 / 0.14);
		color: var(--color-white);
		text-decoration: none;
		position: relative;
	}

	.post-contents__list li:last-child .post-contents__link {
		border-bottom: none;
	}

	.post-contents__num {
		flex-shrink: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.9375rem; /* 15px */
		line-height: 1.45;
		color: var(--color-red-on-navy);
	}

	.post-contents__label {
		font-family: var(--font-body);
		font-size: 0.875rem; /* 14px */
		font-weight: 500;
		line-height: 1.45;
	}

	.post-contents__link--active {
		color: var(--color-white);
	}

	.post-contents__link--active::before {
		content: "";
		position: absolute;
		left: -32px;
		top: 10px;
		bottom: 10px;
		width: 3px;
		background: var(--color-red);
	}

	.post-contents__link--active .post-contents__num {
		color: var(--color-white);
	}
</style>
