---
import { Image } from "astro:assets";
import { getTeamMember, getTeamPhoto } from "../../utils/blog";

interface Props {
	authorSlug: string;
	class?: string;
}

const { authorSlug, class: className = "" } = Astro.props;
const member = getTeamMember(authorSlug);
const photo = getTeamPhoto(authorSlug);

if (!member) {
	return null;
}

const initial = member.name.trim().charAt(0).toUpperCase();
---

<aside class:list={["author-box", className]}>
	<div class="author-box__media" aria-hidden={photo ? undefined : "true"}>
		{
			photo ? (
				<Image
					src={photo}
					alt=""
					class="author-box__photo"
					widths={[96, 192]}
					sizes="96px"
					quality={85}
					loading="lazy"
					decoding="async"
				/>
			) : (
				<span class="author-box__initial">{initial}</span>
			)
		}
	</div>
	<div class="author-box__text">
		<p class="author-box__eyebrow">Written by</p>
		<p class="author-box__name">{member.name}</p>
		<p class="author-box__role">{member.role}</p>
		<p class="author-box__bio">{member.bio}</p>
	</div>
</aside>

<style>
	.author-box {
		display: flex;
		flex-wrap: wrap;
		gap: 20px 28px;
		margin-top: 24px;
		padding: 32px;
		background: var(--color-grey-50);
		box-shadow: inset 0 -5px 0 var(--color-red);
	}

	.author-box__media {
		flex: 0 0 auto;
		width: 96px;
		height: 96px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--color-navy);
		clip-path: polygon(0 0, 100% 0, 100% 80%, 80% 100%, 0 100%);
	}

	.author-box__photo,
	.author-box :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.author-box__initial {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 2.625rem; /* 42px */
		line-height: 1;
		color: var(--color-white);
	}

	.author-box__text {
		flex: 1 1 300px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.author-box__eyebrow {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 0.8125rem; /* 13px */
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-red);
	}

	.author-box__name {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.625rem; /* 26px */
		line-height: 1.1;
		text-transform: uppercase;
		color: var(--color-navy);
	}

	.author-box__role {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.875rem; /* 14px */
		font-weight: 600;
		color: var(--color-navy);
	}

	.author-box__bio {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--color-text-body);
	}

	@media (max-width: 639px) {
		.author-box {
			flex-direction: column;
			padding: 28px 24px;
		}
	}
</style>
