---
import Button from "../ui/Button.astro";
import { blogNewsletter as defaults } from "../../content/blog";

interface Props {
	title?: string;
	body?: string;
	emailLabel?: string;
	placeholder?: string;
	submitLabel?: string;
	class?: string;
}

const {
	title = defaults.title,
	body = defaults.body,
	emailLabel = defaults.emailLabel,
	placeholder = defaults.placeholder,
	submitLabel = defaults.submitLabel,
	class: className = "",
} = Astro.props;
---

<section class:list={["blog-newsletter", "clears-footer", className]}>
	<div class="blog-newsletter__deco" aria-hidden="true">
		<div class="blog-newsletter__band blog-newsletter__band--top"></div>
		<div class="blog-newsletter__band blog-newsletter__band--royal"></div>
		<div class="blog-newsletter__band blog-newsletter__band--red"></div>
		<div class="blog-newsletter__band blog-newsletter__band--navy"></div>
		<div class="blog-newsletter__band blog-newsletter__band--corner"></div>
	</div>

	<div class="container blog-newsletter__inner">
		<div class="blog-newsletter__copy">
			<h2 class="blog-newsletter__title">{title}</h2>
			<p class="blog-newsletter__body">{body}</p>
			<form class="blog-newsletter__form" method="post" action="/contact">
				<label class="blog-newsletter__label" for="blog-newsletter-email">
					{emailLabel}
				</label>
				<div class="blog-newsletter__row">
					<input
						id="blog-newsletter-email"
						class="blog-newsletter__input"
						type="email"
						name="email"
						autocomplete="email"
						required
						placeholder={placeholder}
					/>
					<Button type="submit" variant="dark">{submitLabel}</Button>
				</div>
			</form>
		</div>
	</div>
</section>

<style>
	.blog-newsletter {
		--nl-slant: 56px;
		position: relative;
		z-index: 0;
		overflow: visible;
		margin-top: calc(var(--nl-slant) * -1);
		padding-block: 160px;
		background: var(--color-red-deep);
		color: var(--color-white);
		clip-path: polygon(0 var(--nl-slant), 100% 0, 100% 100%, 0 100%);
	}

	.blog-newsletter__deco {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.blog-newsletter__band {
		position: absolute;
		inset: 0;
	}

	.blog-newsletter__band--top {
		background: var(--color-red);
		clip-path: polygon(0 var(--nl-slant), 100% 0, 100% 18%, 0 46%);
	}

	.blog-newsletter__band--royal {
		background: var(--color-royal);
		clip-path: polygon(74% 0, 76.4% 0, 60.4% 100%, 58% 100%);
	}

	.blog-newsletter__band--red {
		background: var(--color-red);
		clip-path: polygon(77.6% 0, 79.6% 0, 63.6% 100%, 61.6% 100%);
	}

	.blog-newsletter__band--navy {
		background: var(--color-navy);
		clip-path: polygon(80.8% 0, 100% 0, 100% 100%, 64.8% 100%);
	}

	.blog-newsletter__band--corner {
		background: var(--color-red);
		clip-path: polygon(100% 68%, 100% 100%, 80% 100%);
	}

	.blog-newsletter__inner {
		position: relative;
		z-index: 1;
	}

	.blog-newsletter__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
		max-width: 680px;
	}

	.blog-newsletter__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 4.8vw, 4.5rem);
		font-weight: 700;
		line-height: 0.98;
		text-transform: uppercase;
		color: var(--color-white);
	}

	.blog-newsletter__body {
		margin: 0;
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-text-on-red);
		max-width: 48ch;
	}

	.blog-newsletter__form {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 10px;
		width: 100%;
		max-width: 560px;
		margin-top: 12px;
	}

	.blog-newsletter__label {
		font-family: var(--font-heading);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-white);
	}

	.blog-newsletter__row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		align-items: stretch;
	}

	.blog-newsletter__input {
		flex: 1 1 240px;
		min-height: 54px;
		padding: 0 18px;
		border: none;
		background: var(--color-white);
		color: var(--color-navy);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.blog-newsletter__input::placeholder {
		color: var(--color-grey-400);
	}

	.blog-newsletter__row :global(.btn-wrap) {
		flex: 0 0 auto;
	}

	@media (max-width: 1023px) {
		.blog-newsletter__band--royal,
		.blog-newsletter__band--red {
			display: none;
		}

		.blog-newsletter__band--navy {
			clip-path: polygon(100% 40%, 100% 100%, 55% 100%);
		}
	}

	@media (max-width: 639px) {
		.blog-newsletter {
			--nl-slant: 32px;
			padding-block: 112px 120px;
		}

		.blog-newsletter__band--navy {
			display: none;
		}

		.blog-newsletter__row {
			flex-direction: column;
		}

		.blog-newsletter__row :global(.btn-wrap),
		.blog-newsletter__row :global(.btn) {
			width: 100%;
		}
	}
</style>
